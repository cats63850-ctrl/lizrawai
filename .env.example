# Скопируй этот файл в .env и впиши свой токен:
#   cp .env.example .env
#
# Токен: https://discord.com/developers/applications
#   → твоё приложение → Bot → Reset Token
# Там же включи MESSAGE CONTENT INTENT, иначе бот не увидит текст сообщений.
DISCORD_TOKEN=

# Префикс команд по умолчанию. На сервере меняется через g.prefix.
DEFAULT_PREFIX=g.

# Файл базы с корпусом сообщений.
DATABASE_PATH=markovbot.db

# ID своего сервера — слэш-команды появятся сразу, а не через час.
# Оставь пустым для глобальной синхронизации.
DEV_GUILD_ID=
