# Системный systemd-юнит для VPS: отдельный юзер, автозапуск при загрузке.
#
# Установка (от root):
#   useradd -r -m -d /opt/markovbot -s /usr/sbin/nologin markovbot
#   cp -r <проект>/* /opt/markovbot/
#   chown -R markovbot:markovbot /opt/markovbot
#   sudo -u markovbot python -m venv /opt/markovbot/.venv
#   sudo -u markovbot /opt/markovbot/.venv/bin/pip install -r /opt/markovbot/requirements.txt
#   cp deploy/markovbot-system.service /etc/systemd/system/markovbot.service
#   systemctl daemon-reload
#   systemctl enable --now markovbot
#
# Логи: journalctl -u markovbot -f

[Unit]
Description=Markov Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=markovbot
Group=markovbot
WorkingDirectory=/opt/markovbot
ExecStart=/opt/markovbot/.venv/bin/python /opt/markovbot/bot.py

Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

# Базовая изоляция: боту нужна только своя папка и сеть.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/markovbot

[Install]
WantedBy=multi-user.target
