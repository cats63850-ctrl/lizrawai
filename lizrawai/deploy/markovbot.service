# Пользовательский systemd-юнит: бот живёт под твоим юзером, без root.
# Подходит и для домашней машины, и для VPS, если не хочется системного юнита.
#
# Установка:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/markovbot.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now markovbot
#
# Чтобы бот работал и когда ты не залогинен (в т.ч. после перезагрузки):
#   loginctl enable-linger $USER
#
# Логи:    journalctl --user -u markovbot -f
# Рестарт: systemctl --user restart markovbot
#
# Юнит рассчитан на то, что проект лежит в ~/markovbot и venv в ~/markovbot/.venv
# Если путь другой — поправь WorkingDirectory и ExecStart.

[Unit]
Description=Markov Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/markovbot
ExecStart=%h/markovbot/.venv/bin/python %h/markovbot/bot.py

# Discord иногда рвёт соединение — поднимаем бота обратно.
Restart=always
RestartSec=10

# Чтобы логи шли в journalctl без задержек буферизации.
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
